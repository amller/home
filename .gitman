gitman() {
    local GITIGNORE=~/.gitignore
    local HEADER_LINES=8

    IFS="/" read -ra PARTS <<< "$1"
    local DIR=""
    for PART in "${PARTS[@]}"; do
        [[ "$PART" == "${PARTS[-1]}" ]] && break
        DIR="$DIR$PART/"
            if ! grep --quiet --line-regexp --fixed-strings "!$DIR" "$GITIGNORE" 2>/dev/null; then
                echo "!$DIR" >> "$GITIGNORE"
            fi
    done

    if grep --quiet --line-regexp --fixed-strings "!$1" "$GITIGNORE" 2>/dev/null; then
        echo "$1 already exists in gitman-gitignore"
        return
    fi

    echo "!$1" >> "$GITIGNORE"
    local HEADER=$(head --lines=$HEADER_LINES $GITIGNORE)
    local BODY=$(tail --lines=+$((HEADER_LINES + 1)) "$GITIGNORE" | sort)
    echo -e "$HEADER\n$BODY" > "$GITIGNORE"
    echo "Added $1 to gitman-gitignore"
}

