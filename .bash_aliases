#
# ~/.bash_aliases
#

# shell
alias cd="pushd 1>/dev/null"
alias ls="ls -l --all --group-directories-first --human-readable --color=auto --indicator-style=slash --time-style=\"+%y-%m-%d %H:%M\""
alias grep="grep --color=auto"

# top
alias top="btop"

# Podman
alias p="podman"
alias docker="podman"

